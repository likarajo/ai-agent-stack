# Default path is fully local and free. No keys required.
SKIP_MODEL=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional hosted OpenAI-compatible endpoint (off by default)
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

ISSUE_API_BASE_URL=http://127.0.0.1:8000

# Optional Agent Debugger (off by default; API on :8000 matches agent-debugger compose)
# AGENT_DEBUGGER_URL=http://127.0.0.1:8000
# AGENT_DEBUGGER_AUTO_APPROVE=0
# AGENT_DEBUGGER_PATH=./third_party/agent-debugger
# When using `make debugger-up`, Docker issue-api is on host :8001 (Debugger owns :8000).
# ISSUE_API_BASE_URL=http://127.0.0.1:8001
